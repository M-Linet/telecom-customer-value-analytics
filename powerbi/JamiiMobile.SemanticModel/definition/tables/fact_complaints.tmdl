table fact_complaints
	lineageTag: 0c33b27d-dcdd-5b5d-86b6-42130f31f71d

	column complaint_id
		dataType: string
		lineageTag: 61b0d848-bfbe-5315-97c7-40a43308d6f9
		summarizeBy: none
		sourceColumn: complaint_id

	column customer_id
		dataType: string
		isHidden
		lineageTag: 59b1572f-06e9-53b9-b7f9-64170d9925fc
		summarizeBy: none
		sourceColumn: customer_id

	column month
		dataType: dateTime
		formatString: dd mmm yyyy
		isHidden
		lineageTag: cc5285f3-7b28-5918-8423-a4464c0678c1
		summarizeBy: none
		sourceColumn: month

	column complaint_category
		dataType: string
		lineageTag: f2b4041e-c084-5af5-980f-e8d608294725
		summarizeBy: none
		sourceColumn: complaint_category

	column resolution_status
		dataType: string
		lineageTag: ad61b850-a2d8-5243-a98f-33c1b31de861
		summarizeBy: none
		sourceColumn: resolution_status

	column days_to_resolve
		dataType: double
		lineageTag: 90131a6f-a7d7-51e1-9fe8-1a31cf057309
		summarizeBy: none
		sourceColumn: days_to_resolve

	partition fact_complaints = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_complaints.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"complaint_id", type text}, {"customer_id", type text}, {"month", type date}, {"complaint_category", type text}, {"resolution_status", type text}, {"days_to_resolve", type number}}, "en-US")
				in
				    Typed

